{
  "name": "commute-wise-chrome-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Chrome extension that augments Google Maps with rain and route-condition information. BYO OpenWeatherMap key.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.33",
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.40",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
